{
  "manifest_version": 3,
  "name": "YouFloww New Tab",
  "short_name": "YouFloww",
  "version": "1.0.0",
  "description": "Turn every new tab into a calm focus space: clock, focus timer, today's intention, quick links and search.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "permissions": ["search"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
