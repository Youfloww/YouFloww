{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/__/:path*",
      "destination": "https://youfloww2.firebaseapp.com/__/:path*"
    },
    {
      "source": "/((?!__/|api/|assets/|sounds/|img/|icons/|pledge/|sw.js|workbox-).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/pledge/settle",
      "schedule": "30 3 * * *"
    }
  ],
  "functions": {
    "api/pledge/*.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sounds/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
