{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/__/:path*",
      "destination": "https://youfloww2.firebaseapp.com/__/:path*"
    },
    {
      "source": "/((?!__/|api/|assets/|sounds/|img/|icons/|pledge/|sw.js|boot.js|ga.js|workbox-).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/pledge/settle",
      "schedule": "30 3 * * *"
    }
  ],
  "functions": {
    "api/pledge/*.ts": {
      "maxDuration": 30
    },
    "api/focus/*.ts": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/((?!__/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; script-src 'self' https://apis.google.com https://www.gstatic.com https://www.googletagmanager.com https://*.google-analytics.com https://checkout.razorpay.com https://*.razorpay.com https://www.youtube.com https://s.ytimg.com https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.22.0/dist/tf.min.js https://cdn.jsdelivr.net/npm/@tensorflow-models/coco-ssd@2.2.3/dist/coco-ssd.min.js; worker-src 'self' blob:"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=(self \"https://api.razorpay.com\" \"https://checkout.razorpay.com\")"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sounds/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
